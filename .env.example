# .env.example をコピーして .env を作成し、実際の値を設定してください。
#   cp .env.example .env
# .env は .gitignore 済みです。絶対にコミットしないでください。

# 必須: アプリポータルで発行したAPIキー（閲覧権限のみのユーザーで発行することを推奨）
# 右辺全体を、発行されたキー（mf_api_ で始まる文字列）そのものに置き換えてください
MF_API_KEY=REPLACE_WITH_YOUR_API_KEY

# 必須（Step 2 以降）: 事業者番号 XXXX-XXXX
# `python -m mf_accounting offices` で確認できます
MF_OFFICE_CODE=0000-0000

# 任意: 全期間取得（Step 6）の範囲を絞る場合 YYYY-MM-DD
MF_JOURNALS_START_DATE=
MF_JOURNALS_END_DATE=

# 任意: 1ページあたりの件数（journals: 1〜10000, transactions: 10〜500）
MF_JOURNALS_PER_PAGE=1000
MF_TRANSACTIONS_PER_PAGE=500

# 任意: 保存先ディレクトリ
MF_DATA_DIR=data

# 任意（Phase 4 以降）: Claude API キー。`ant auth login` のプロファイルを使う場合は不要
# ANTHROPIC_API_KEY=
# ワークスペースに紐付かないキーの場合のみ: ワークスペースID（Claude Console で確認）
# ANTHROPIC_WORKSPACE_ID=
